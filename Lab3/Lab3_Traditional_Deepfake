   "id": "example_train_07",
   "metadata": {},
   "source": [
    "### Training a Baseline Classifier\n",
    "Now we generate a simulated dataset of 1000 audio representations (500 real, 500 fake) based on our features to train a Support Vector Machine (SVM)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "example_model_08",
   "metadata": {},
   "outputs": [],
   "source": [
    "# WORKED EXAMPLE: Training a Classifier\n",
    "# We use sklearn to simulate a dataset representing extracted features\n",
    "X_demo, y_demo = make_classification(n_samples=1000, n_features=20, n_informative=15, \n",
    "                                     random_state=42, weights=[0.5, 0.5])\n",
    "\n",
    "# 0 = Fake/Spoof, 1 = Real/Bona Fide\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_demo, y_demo, test_size=0.3, random_state=42)\n",
    "\n",
    "svm_model = SVC(kernel='linear', probability=True)\n",
    "svm_model.fit(X_train, y_train)\n",
    "\n",
    "y_pred = svm_model.predict(X_test)\n",
    "accuracy = accuracy_score(y_test, y_pred)\n",
    "\n",
    "print(f\"Baseline SVM Accuracy: {accuracy * 100:.2f}%\")\n"
   ]
